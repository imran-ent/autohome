# =============================================================================
# SERVER ENVIRONMENT VARIABLES (server/.env)
# =============================================================================
# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/autohome_batteries

# JWT
JWT_SECRET=your_super_secret_jwt_secret_change_me
JWT_EXPIRE=7d

# Admin seed (initial admin account)
ADMIN_EMAIL=autohomebatteries@gmail.com
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=Mohammed Umer A

# Business contact
BUSINESS_PHONE_1=9789688756
BUSINESS_PHONE_2=943437168
BUSINESS_EMAIL=autohomebatteries@gmail.com
BUSINESS_ADDRESS=Opp. SN Tea Stall, Maula Street, Pernambut 635810, Tamil Nadu
BUSINESS_TIMING=6:00 AM to 10:00 PM

# Puter AI
PUTER_AUTH_TOKEN=your_puter_auth_token_here
PUTER_MODEL=gpt-5.5

# =============================================================================
# CLIENT ENVIRONMENT VARIABLES (client/.env)
# =============================================================================
VITE_API_URL=http://localhost:5000
# Production: VITE_API_URL=https://your-backend.onrender.com

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
# 1. Copy .env.example to .env in both server/ and client/ directories
# 2. Replace placeholder values with your actual secrets
# 3. NEVER commit .env files to Git - they are in .gitignore
# 4. Set environment variables in your deployment platform (Render, Cloudflare Pages)